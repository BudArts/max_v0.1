# Локальная конфигурация: после копирования в .env сервис поднимается командой
#   docker compose up -d
# достаточно вписать MAX_BOT_TOKEN (и GIGACHAT_CREDENTIALS, если нужен наставник).
#
# Для боевого контура измените: APP_ENV=production, SSL_ENABLED=true, HTTP_PORT=80,
# HTTPS_PORT=443, MAX_TRANSPORT=webhook, DEV_LOGIN_ENABLED=false, SEED_DEMO=false,
# SECRET_KEY и FIELD_ENCRYPTION_KEY - результат `openssl rand -hex 32`,
# POSTGRES_PASSWORD и DATABASE_URL - свои значения, APP_DOMAIN и APP_BASE_URL - домен школы.
# Секреты не должны попадать в репозиторий.

# --- Приложение ---
APP_NAME=УчусьИИ
# development | staging | production
APP_ENV=development
APP_DEBUG=false
APP_BASE_URL=http://localhost:8080
# Домен для nginx (server_name)
APP_DOMAIN=localhost
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=

# --- Публикация (nginx) ---
# false - только HTTP (локальная проверка), true - TLS, нужны сертификаты в deploy/certs
SSL_ENABLED=false
HTTP_PORT=8080
HTTPS_PORT=8443

# --- База данных ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app
DB_ECHO=false

# --- Ключи ---
# Значения ниже - демонстрационные. Для боевого контура: openssl rand -hex 32
# (в production значения с префиксом dev-only- и CHANGE_ME отклоняются при старте).
SECRET_KEY=dev-only-secret-key-please-change-0123456789
FIELD_ENCRYPTION_KEY=dev-only-field-key-please-change-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
MINIAPP_AUTH_WINDOW_SECONDS=3600

# --- Демо-вход вне MAX ---
# true: мини-приложение показывает выбор кабинета (родитель, педагог),
# стартовые данные подписывает сервер. Значение передаётся в сборку мини-приложения.
# При APP_ENV=production режим должен быть выключен: DEV_LOGIN_ENABLED=false.
DEV_LOGIN_ENABLED=true

# --- MAX ---
# Токен бота из кабинета разработчика MAX - единственное обязательное значение для локального запуска
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
# webhook - боевой режим, нужен публичный HTTPS-адрес
# polling - бот отвечает без публичного адреса (локальная проверка)
# disabled - API без бота
MAX_TRANSPORT=polling
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=dev-only-webhook-secret-please-change-0123
# Корневой сертификат Минцифры; каталог deploy/certs монтируется в /etc/ssl/uchusai
MAX_CA_BUNDLE=/etc/ssl/uchusai/russian_trusted_ca.pem
MAX_REQUEST_TIMEOUT=15
# false - только для диагностики TLS, в постоянной работе не оставлять
MAX_VERIFY_SSL=true

# --- GigaChat ---
# Ассистент включается после указания ключа; сертификат Минцифры обязателен
GIGACHAT_ENABLED=false
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_VERIFY_SSL=true
GIGACHAT_CA_BUNDLE=/etc/ssl/uchusai/russian_trusted_ca.pem
GIGACHAT_TIMEOUT=45

# --- Лимиты и сроки хранения ---
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_HOUR=20
LOG_LEVEL=INFO
AUDIT_RETENTION_DAYS=1095
PERSONAL_DATA_RETENTION_DAYS=365

# --- Действия при старте контейнера ---
# Миграции и редакции документов выполняет backend, worker их пропускает.
RUN_MIGRATIONS=true
SYNC_POLICIES=true
# Демо-данные заполняются только при APP_ENV=development
SEED_DEMO=true
REGISTER_BOT_COMMANDS=true
